         RowBox[{"Sv", "[", 
          RowBox[{"\[Epsilon]", ",", "S"}], "]"}]}]}], "-", 
       RowBox[{"6", "*", 
        RowBox[{
         RowBox[{
          RowBox[{"Sv", "[", 
           RowBox[{"\[Epsilon]", ",", "S"}], "]"}], ".", 
          RowBox[{"rv", "[", 
           RowBox[{"r", ",", "\[Phi]"}], "]"}]}], "/", 
         RowBox[{"r", "^", "2"}]}], "*", 
        RowBox[{
         RowBox[{"vv", "[", 
          RowBox[{"r", ",", "\[Phi]"}], "]"}], "\[Cross]", 
         RowBox[{"rv", "[", 
          RowBox[{"r", ",", "\[Phi]"}], "]"}]}]}]}], ")"}]}], ")"}]}], "//", 
  "FullSimplify"}]], "Input",
