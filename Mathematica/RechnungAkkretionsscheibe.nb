Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"rv", "[", 
    RowBox[{"r", ",", "\[Phi]"}], "]"}], "\[Cross]", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[Sigma]", "/", 
