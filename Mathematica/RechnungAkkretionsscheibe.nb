98cd6151066d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"rv", "[", 
   RowBox[{"r_", ",", "\[Phi]_"}], "]"}], "=", 
  RowBox[{"r", "*", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
     RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "0"}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vv", "[", 
   RowBox[{"r_", ",", "\[Phi]_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{"M", "/", "r"}], "]"}], "*", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
     RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "0"}], 
    "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Sv", "[", 
   RowBox[{"\[Epsilon]_", ",", "S_"}], "]"}], "=", 
  RowBox[{"S", "*", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sin", "[", "\[Epsilon]", "]"}], ",", "0", ",", 
     RowBox[{"Cos", "[", "\[Epsilon]", "]"}]}], "}"}]}]}]}], "Input",
 CellChangeTimes->{{3.957510486865191*^9, 3.957510551038903*^9}, {
  3.9575105885022917`*^9, 3.9575106079683743`*^9}, {3.957510691196313*^9, 
